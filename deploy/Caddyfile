# Caddy reverse proxy: automatic free HTTPS for the domain in ${DOMAIN}.
# The phone PWA (camera, install prompt, service worker) requires HTTPS
# when used outside the local network, so this file is mandatory for that.

{$DOMAIN} {
	# Reject huge bodies before they hit the app (app limit is 10MB).
	request_body max_size 11MB

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		# Remove upstream Server header details
		-Server
	}

	reverse_proxy receiptvision:8080
}
