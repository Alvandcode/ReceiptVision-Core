# Maven build output
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Compiled classes
*.class

# Package files (keep builds out of git)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Logs
*.log
logs/

# H2 database files (local /data should never be committed)
*.db
*.mv.db
*.trace.db
/data/

# IDE
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.code-workspace
.settings/
.classpath
.project
*.factorypath

# OS
.DS_Store
Thumbs.db

# Env secrets
.env
.env.local

# JVM crash logs
hs_err_pid*
replay_pid*

# Temp OCR files
/tmp/ocr/
